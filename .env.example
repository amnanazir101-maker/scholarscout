# Copy this file to .env and fill in your key. Never commit .env.

# LLM provider: gemini (free tier, default) or claude (paid)
SCHOLARSCOUT_PROVIDER=gemini

# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed with SCHOLARSCOUT_PROVIDER=claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: model (empty = provider default: gemini-3.8-flash or claude-opus-5-5)
# gemini-3.5-flash-lite is faster.
SCHOLARSCOUT_MODEL=
# Optional: thinking effort (low | medium | high)
SCHOLARSCOUT_EFFORT=medium

# Optional: a free OpenAlex key gives you your own daily search budget
# (https://openalex.org/settings/api). Without it, searches share a small budget per IP.
OPENALEX_API_KEY=

# Optional: size of each run
SCHOLARSCOUT_MAX_PAPERS=15
SCHOLARSCOUT_FULL_TEXT_PAPERS=4
SCHOLARSCOUT_MAX_REVISIONS=1
